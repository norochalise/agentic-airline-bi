# Copy to .env and fill in your own values. .env is gitignored.

# Required: OpenAI key for the agent, interaction router and answer writer.
OPENAI_API_KEY=

# Required: chat model used for every LLM call (e.g. gpt-4.1-mini).
OPENAI_MODEL=

# Required for official-web answers (delta.com, transportation.gov,
# faa.gov, bts.gov). Without it, web questions fail with a clear error.
EXA_API_KEY=

# Optional: show an estimated cost per answer. USD per million tokens for
# OPENAI_MODEL, from OpenAI's pricing page. Cached input defaults to the input price.
# OPENAI_INPUT_PRICE_PER_M=
# OPENAI_CACHED_INPUT_PRICE_PER_M=
# OPENAI_OUTPUT_PRICE_PER_M=

# Optional: protect the API budget on a public deployment.
# Questions per minute per client (0 = off) and per day for everyone (0 = no cap).
# ASK_RATE_LIMIT=10
# ASK_DAILY_LIMIT=200

# Behind a hosting proxy, let uvicorn read the visitor IP from X-Forwarded-For.
# FORWARDED_ALLOW_IPS=*
